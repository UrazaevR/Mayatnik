/* Общие настройки */
* {
    font-family: "Segoe UI", "Arial", sans-serif;
}

/* Главное окно */
QWidget {
    font-size: 14px;
    background-color: #ffffff;
}

/* Метки (QLabel) - Увеличенный шрифт */
QLabel {
    font-size: 18px;
    font-weight: 500;
    padding: 4px;
    color: #1a1a1a;
}

/* Поля ввода (QLineEdit) - черный текст */
QLineEdit {
    font-size: 14px;
    padding: 6px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: white;
    color: #000000;  /* Черный текст */
}

QLineEdit:focus {
    border: 1px solid #4CAF50;
}

/* Кнопки (QPushButton) */
QPushButton {
    font-size: 16px;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    background-color: #4CAF50;
    color: white;
    border: none;
}

QPushButton:hover {
    background-color: #45a049;
}

QPushButton:pressed {
    background-color: #3d8b40;
}

QPushButton:disabled {
    background-color: #cccccc;
    color: #666666;
}

/* Чекбоксы (QCheckBox) */
QCheckBox {
    font-size: 16px;
    spacing: 8px;
    color: #1a1a1a;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

/* Статус бар (QLabel, используемый как statusLab) */
QLabel#statusLab {
    font-size: 18px;
    font-weight: bold;
    padding: 10px;
    background-color: #f0f0f0;
    border-radius: 4px;
    color: #2c3e50;
}

/* Для всех QLabel в статус баре */
.status-bar {
    font-size: 18px;
    font-weight: bold;
}

/* Tab widget если используется */
QTabWidget::pane {
    font-size: 14px;
}

QTabBar::tab {
    font-size: 15px;
    padding: 8px 14px;
}

/* Group box */
QGroupBox {
    font-size: 16px;
    font-weight: bold;
    border: 1px solid #ccc;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* Scroll bars */
QScrollBar:vertical {
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #4CAF50;
    border-radius: 6px;
    min-height: 20px;
}

/* Toolbar для графиков */
QToolBar {
    font-size: 14px;
    background: #000000;
}

QToolButton {
    font-size: 13px;
    background: #101010;
}

/* Menu bar если есть */
QMenuBar {
    font-size: 15px;
}

QMenuBar::item {
    padding: 6px 10px;
}

QMenu {
    font-size: 15px;
}

/* Дополнительные стили для заголовков внутри вкладок */
QLabel[heading="true"] {
    font-size: 20px;
    font-weight: bold;
    color: #2c3e50;
}